# Camera robot and ROS bridge defaults.

# Camera robot pose. The robot base_link and gimbal_link origins coincide.
: "${WEBOTS_CAMERA_X:=0}"
: "${WEBOTS_CAMERA_Y:=0}"
: "${WEBOTS_CAMERA_Z:=0.405}"
: "${WEBOTS_CAMERA_OFFSET:=0 0 0}"

# Initial camera aiming. Empty WEBOTS_CAMERA_LOOK_AT_Z uses
# WEBOTS_ARMOR_TARGET_Z + WEBOTS_CAMERA_LOOK_AT_Z_OFFSET.
: "${WEBOTS_CAMERA_LOOK_AT_TARGET:=true}"
: "${WEBOTS_CAMERA_LOOK_AT_Z:=}"
: "${WEBOTS_CAMERA_LOOK_AT_Z_OFFSET:=0.055}"
: "${WEBOTS_CAMERA_GREEN_AXIS_OFFSET:=1.57079632679}"
: "${WEBOTS_CAMERA_YAW:=0}"
: "${WEBOTS_CAMERA_TILT:=0.06158867632}"
: "${WEBOTS_CAMERA_X_ROTATION:=0}"
: "${WEBOTS_CAMERA_ROLL:=0}"

# Webots camera sensor and rendered camera body.
: "${WEBOTS_CAMERA_NAME:=camera}"
: "${WEBOTS_CAMERA_WIDTH:=1440}"
: "${WEBOTS_CAMERA_HEIGHT:=1080}"
: "${WEBOTS_CAMERA_FOV:=0.7850335620966933}"
: "${WEBOTS_CAMERA_NEAR:=0.05}"
: "${WEBOTS_CAMERA_FAR:=30}"
: "${WEBOTS_CAMERA_ANTI_ALIASING:=TRUE}"
: "${WEBOTS_CAMERA_MOTION_BLUR:=0}"
: "${WEBOTS_CAMERA_BODY_SIZE:=0.10 0.08 0.08}"
: "${WEBOTS_CAMERA_BODY_COLOR:=0.82 0.86 0.90}"

# ROS CameraInfo calibration.
: "${WEBOTS_CAMERA_FX:=1739.130435}"
: "${WEBOTS_CAMERA_FY:=1739.130435}"
: "${WEBOTS_CAMERA_CX:=719.5}"
: "${WEBOTS_CAMERA_CY:=539.5}"
: "${WEBOTS_CAMERA_DISTORTION_MODEL:=plumb_bob}"
: "${WEBOTS_CAMERA_D:=0 0 0 0 0}"

# ROS image and camera topics.
: "${WEBOTS_IMAGE_TOPIC:=/image_raw}"
: "${WEBOTS_CAMERA_INFO_TOPIC:=/camera_info}"
: "${WEBOTS_CAMERA_FRAME_ID:=camera_optical_frame}"
: "${WEBOTS_IMAGE_ENCODING:=bgr8}"

# Simulated lower-controller inputs consumed by bringup_sim.
: "${WEBOTS_GIMBAL_CMD_TOPIC:=/armor_solver/cmd_gimbal}"
: "${WEBOTS_PUBLISH_SERIAL_RECEIVE:=true}"
: "${WEBOTS_SERIAL_RECEIVE_TOPIC:=/serial/receive}"
: "${WEBOTS_PUBLISH_JOINT_STATES:=true}"
: "${WEBOTS_JOINT_STATES_TOPIC:=/joint_states}"
: "${WEBOTS_PUBLISH_TF:=true}"
: "${WEBOTS_PUBLISH_ODOM_RECTIFY_TF:=true}"
: "${WEBOTS_PUBLISH_CAMERA_FRAME_ALIAS_TF:=true}"
: "${WEBOTS_TARGET_FRAME_ID:=odom}"
: "${WEBOTS_BASE_FRAME_ID:=base_link}"
: "${WEBOTS_GIMBAL_FRAME_ID:=gimbal_link}"
: "${WEBOTS_CAMERA_LINK_FRAME_ID:=camera_link}"
: "${WEBOTS_CAMERA_OPTICAL_LINK_FRAME_ID:=camera_optical_link}"
: "${WEBOTS_ODOM_RECTIFY_FRAME_ID:=${WEBOTS_TARGET_FRAME_ID}_rectify}"
: "${WEBOTS_BASE_TF_X:=0}"
: "${WEBOTS_BASE_TF_Y:=0}"
: "${WEBOTS_BASE_TF_Z:=0}"
: "${WEBOTS_BASE_TF_ROLL:=0}"
: "${WEBOTS_BASE_TF_PITCH:=0}"
: "${WEBOTS_BASE_TF_YAW:=0}"
: "${WEBOTS_GIMBAL_TF_X:=0}"
: "${WEBOTS_GIMBAL_TF_Y:=0}"
: "${WEBOTS_GIMBAL_TF_Z:=0}"
: "${WEBOTS_CAMERA_TF_X:=0.12514}"
: "${WEBOTS_CAMERA_TF_Y:=0}"
: "${WEBOTS_CAMERA_TF_Z:=0.0505}"
: "${WEBOTS_CAMERA_TF_ROLL:=0}"
: "${WEBOTS_CAMERA_TF_PITCH:=0}"
: "${WEBOTS_CAMERA_TF_YAW:=0}"
: "${WEBOTS_CAMERA_OPTICAL_TF_ROLL:=-1.57079632679}"
: "${WEBOTS_CAMERA_OPTICAL_TF_PITCH:=0}"
: "${WEBOTS_CAMERA_OPTICAL_TF_YAW:=-1.57079632679}"
: "${WEBOTS_SERIAL_MODE:=0}"

# Realism parameters for delayed gimbal and shooter behavior.
# Delays are fixed values in ms and may be 0 for idealized simulation.
: "${WEBOTS_GIMBAL_YAW_RESPONSE_DELAY_MS:=0.0}"
: "${WEBOTS_GIMBAL_PITCH_RESPONSE_DELAY_MS:=0.0}"
: "${WEBOTS_FIRE_DELAY_MS:=0.0}"
# Projectile fire rate in Hz. 0 disables rate limiting for idealized simulation.
: "${WEBOTS_FIRE_RATE_HZ:=20.0}"
# Projectile initial speed in m/s.
: "${WEBOTS_BULLET_SPEED:=22.5}"

# Score system controller.
: "${WEBOTS_SCORE_ENABLED:=true}"
: "${WEBOTS_SCORE_TOPIC:=/webots/score}"
: "${WEBOTS_SCORE_CONTROLLER_STEP_MS:=16}"
: "${WEBOTS_SCORE_PUBLISH_PERIOD_MS:=200}"
: "${WEBOTS_SCORE_ARMOR_WIDTH:=0.135}"
: "${WEBOTS_SCORE_ARMOR_HEIGHT:=0.135}"
: "${WEBOTS_SCORE_MAX_FLIGHT_TIME:=2.0}"
: "${WEBOTS_SCORE_GRAVITY:=9.80665}"
: "${WEBOTS_SCORE_SHOOTER_OFFSET_X:=0.0}"
: "${WEBOTS_SCORE_SHOOTER_OFFSET_Y:=0.0}"
: "${WEBOTS_SCORE_SHOOTER_OFFSET_Z:=0.0}"
: "${WEBOTS_SCORE_SHOOTER_FORWARD_X:=1.0}"
: "${WEBOTS_SCORE_SHOOTER_FORWARD_Y:=0.0}"
: "${WEBOTS_SCORE_SHOOTER_FORWARD_Z:=0.0}"

# SetMode service bridge. This replaces virtual_serial_node in Webots runs.
: "${WEBOTS_ENABLE_SET_MODE_CLIENTS:=true}"
: "${WEBOTS_SET_MODE_SERVICES:=armor_detector/set_mode gimbal_pipeline/set_mode}"
: "${WEBOTS_SET_MODE_PERIOD_MS:=500}"

# Ground-truth debug topics.
: "${WEBOTS_TARGET_POSE_TOPIC:=/webots/target_pose}"
: "${WEBOTS_ARMOR_POSES_TOPIC:=/webots/armor_poses}"
: "${WEBOTS_FRONT_ARMOR_POSE_TOPIC:=/webots/front_armor_pose}"
: "${WEBOTS_REAR_ARMOR_POSE_TOPIC:=/webots/rear_armor_pose}"
: "${WEBOTS_LEFT_ARMOR_POSE_TOPIC:=/webots/left_armor_pose}"
: "${WEBOTS_RIGHT_ARMOR_POSE_TOPIC:=/webots/right_armor_pose}"
: "${WEBOTS_PUBLISH_CAMERA_POSE:=false}"
: "${WEBOTS_CAMERA_POSE_TOPIC:=/webots/camera_pose}"

# Gimbal command handling.
: "${WEBOTS_CAMERA_FOLLOW_CMD_GIMBAL:=true}"
: "${WEBOTS_GIMBAL_MAX_YAW_RATE:=20.0}"
: "${WEBOTS_GIMBAL_MAX_PITCH_RATE:=20.0}"
: "${WEBOTS_GIMBAL_USE_DIFF_COMMANDS:=false}"
: "${WEBOTS_GIMBAL_ACCEPT_UNKNOWN_MODE:=true}"
: "${WEBOTS_GIMBAL_WEBOTS_YAW_SIGN:=1.0}"
: "${WEBOTS_GIMBAL_WEBOTS_PITCH_SIGN:=-1.0}"

# Camera controller cadence and diagnostics.
: "${WEBOTS_CONTROLLER_STEP_MS:=16}"
: "${WEBOTS_CAMERA_PERIOD_MS:=32}"
: "${WEBOTS_DISABLE_CAMERA_READ:=false}"
: "${WEBOTS_DISABLE_IMAGE_PUBLISH:=false}"
: "${WEBOTS_SKIP_UNSUBSCRIBED_IMAGES:=true}"
: "${WEBOTS_SPIN_PERIOD:=8}"
: "${WEBOTS_PROFILE_PERIOD:=120}"
