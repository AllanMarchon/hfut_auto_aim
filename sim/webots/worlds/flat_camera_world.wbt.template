#VRML_SIM R2025a utf8

WorldInfo {
  basicTimeStep @WEBOTS_BASIC_TIME_STEP@
  optimalThreadCount @WEBOTS_OPTIMAL_THREAD_COUNT@
  coordinateSystem "ENU"
}
Viewpoint {
  orientation 0.376105 0.825404 0.421346 1.73972
  position -2.8 -2.2 1.45
}
Background {
  skyColor [
    @WEBOTS_SKY_COLOR@
  ]
}
DirectionalLight {
  ambientIntensity @WEBOTS_LIGHT_AMBIENT_INTENSITY@
  intensity @WEBOTS_LIGHT_INTENSITY@
