  castShadows FALSE
}
DEF GRAY_GROUND Solid {
  translation 0 0 @WEBOTS_GROUND_Z@
  children [
    Shape {
      appearance PBRAppearance {
        baseColor @WEBOTS_GROUND_COLOR@
        roughness @WEBOTS_GROUND_ROUGHNESS@
        metalness 0
      }
      geometry Box {
        size @WEBOTS_GROUND_SIZE_X@ @WEBOTS_GROUND_SIZE_Y@ @WEBOTS_GROUND_THICKNESS@
      }
      castShadows FALSE
    }
  ]
  name "gray_ground"
  boundingObject Box {
    size @WEBOTS_GROUND_SIZE_X@ @WEBOTS_GROUND_SIZE_Y@ @WEBOTS_GROUND_THICKNESS@
  }
  locked TRUE
}
