DEF SIM_CAMERA_ROBOT Robot {
  translation @WEBOTS_CAMERA_X@ @WEBOTS_CAMERA_Y@ @WEBOTS_CAMERA_Z@
  rotation @WEBOTS_CAMERA_ROTATION@
  supervisor TRUE
  children [
    DEF SIM_CAMERA_PITCH Transform {
      rotation 0 1 0 @WEBOTS_CAMERA_TILT@
      children [
        Transform {
          rotation 1 0 0 @WEBOTS_CAMERA_X_ROTATION@
          children [
            Shape {
              appearance PBRAppearance {
                baseColor @WEBOTS_CAMERA_BODY_COLOR@
                roughness 0.7
                metalness 0
              }
              geometry Box {
                size @WEBOTS_CAMERA_BODY_SIZE@
              }
              castShadows FALSE
            }
            Camera {
              name "@WEBOTS_CAMERA_NAME@"
              rotation 0 0 1 @WEBOTS_CAMERA_ROLL@
              fieldOfView @WEBOTS_CAMERA_FOV@
              width @WEBOTS_CAMERA_WIDTH@
              height @WEBOTS_CAMERA_HEIGHT@
              near @WEBOTS_CAMERA_NEAR@
              far @WEBOTS_CAMERA_FAR@
              antiAliasing @WEBOTS_CAMERA_ANTI_ALIASING@
              motionBlur @WEBOTS_CAMERA_MOTION_BLUR@
            }
          ]
        }
      ]
    }
  ]
  name "sim_camera"
  controller "ros_free_camera_bridge"
}
